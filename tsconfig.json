{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "moduleResolution": "node16",
    "allowJs": false,
    "noImplicitAny": false,

    "types": ["node", "jest"]
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules", "dist", "coverage", "eslint.config.mts"]
}